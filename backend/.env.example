# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-cyber-defense
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/ai-cyber-defense

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# DeepFake Detection (Sightengine or similar)
DEEPFAKE_API_USER=your-sightengine-user
DEEPFAKE_API_SECRET=your-sightengine-secret
DEEPFAKE_API_URL=https://api.sightengine.com/1.0/check.json

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secret (for future auth)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Alert thresholds
ALERT_RISK_THRESHOLD=70
